[Unit]
Description=Guard - Sistema de Webcams (go2rtc)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ngarciam/guard
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/ngarciam/guard/services/webcams/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
