import cv2
import time
import json
import os
import threading
import requests
import glob
from datetime import datetime
from gpiozero import MotionSensor, OutputDevice

# 👉 IMPORTAMOS NUESTRO NUEVO MÓDULO
from lpr_processor import detectar_patente

# --- CONFIGURACIÓN ---
PIN_PIR = 17
PIN_RELE = 27
TIEMPO_ACTIVACION_RELE = 0.5 
DB_LOCAL = "patentes.json"
CAMARA_INDEX = 0
PENDING_DIR = "pendientes_uploads"

# --- CONFIGURACIÓN MQTT ---
MQTT_BROKER = "2d2715a472da427cb5a4b346706179af.s1.eu.hivemq.cloud" # Ejemplo: reemplaza con tu broker real
MQTT_PORT = 8883 # Usa 8883 si tu broker soporta TLS/SSL
MQTT_USER = "rpi_porton"
MQTT_PASS = "Guard123qwe"
MQTT_TOKEN_SEGURO = "mi_secreto_super_seguro_123" # Token para validar que la orden es legítima

TOPIC_COMANDO = "mi_porton/comando"
TOPIC_ESTADO = "mi_porton/estado"

# Endpoints
URL_ENDPOINT_PATENTES = "https://tu-servidor.com/api/patentes-autorizadas"
URL_ENDPOINT_REPORTES = "https://tu-servidor.com/api/reportes-acceso"
API_TOKEN = "tu_token_secreto"

# Intervalos (en segundos)
INTERVALO_ACTUALIZACION_PATENTES = 3600  # 1 hora
INTERVALO_SUBIDA_REPORTES = 30             # 30 segundos (revisa la cola frecuentemente)

# --- INICIALIZACIÓN ---
pir = MotionSensor(PIN_PIR)
rele_porton = OutputDevice(PIN_RELE, active_high=False)

# Crear directorio de pendientes si no existe
os.makedirs(PENDING_DIR, exist_ok=True)


def on_connect(client, userdata, flags, rc):
    if rc == 0:
        print("✅ Conectado al Broker MQTT exitosamente.")
        client.subscribe(TOPIC_COMANDO)
        publicar_estado("EN_LINEA")
    else:
        print(f"❌ Fallo al conectar a MQTT. Código: {rc}")

def on_message(client, userdata, msg):
    """Se ejecuta automáticamente cuando llega un mensaje al tópico de comando."""
    try:
        payload = json.loads(msg.payload.decode())
        
        # 1. Validar seguridad: ¿El mensaje tiene nuestro token secreto?
        if payload.get("token") != MQTT_TOKEN_SEGURO:
            print("⛔ Intento de apertura remota rechazado: Token inválido.")
            return
            
        # 2. Validar acción
        if payload.get("accion") == "ABRIR":
            print("📱 Comando remoto recibido: Abriendo portón...")
            abrir_porton()
            publicar_estado("ABIERTO_REMOTO")
        else:
            print(f"⚠️ Comando remoto desconocido: {payload.get('accion')}")
            
    except json.JSONDecodeError:
        print("❌ Error al decodificar mensaje MQTT.")

def publicar_estado(estado):
    """Envía el estado actual del portón al broker (útil para tu app/celular)."""
    if mqtt_client and mqtt_client.is_connected():
        payload = {"estado": estado, "timestamp": datetime.now().isoformat()}
        mqtt_client.publish(TOPIC_ESTADO, json.dumps(payload), retain=True)

def iniciar_mqtt():
    """Inicializa y conecta el cliente MQTT en segundo plano."""
    global mqtt_client
    mqtt_client = mqtt.Client(client_id="rpi_porton_01")
    mqtt_client.username_pw_set(MQTT_USER, MQTT_PASS)
    mqtt_client.on_connect = on_connect
    mqtt_client.on_message = on_message
    
    # Configurar reconexión automática si se cae el internet
    mqtt_client.reconnect_delay_set(min_delay=1, max_delay=120)
    
    try:
        # connect_async no bloquea el hilo principal
        mqtt_client.connect_async(MQTT_BROKER, MQTT_PORT, keepalive=60)
        mqtt_client.loop_start() # Inicia el hilo de red de paho-mqtt
    except Exception as e:
        print(f"❌ No se pudo iniciar MQTT: {e}")

def cargar_patentes_locales():
    try:
        with open(DB_LOCAL, 'r') as f:
            data = json.load(f)
            return set(data.get("patentes", []))
    except (FileNotFoundError, json.JSONDecodeError):
        return set()

def guardar_en_cola_reportes(img_path, patente, estado):
    """Guarda la imagen y sus metadatos en la cola local para envío diferido."""
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    # Nombre seguro para archivos: reemplazamos caracteres inválidos
    safe_patente = patente if patente else "NO_LEIDA"
    safe_patente = "".join(c for c in safe_patente if c.isalnum())
    
    json_name = f"{timestamp}_{estado}_{safe_patente}.json"
    json_path = os.path.join(PENDING_DIR, json_name)
    
    # Copiamos/movemos la imagen a la carpeta de pendientes con el mismo nombre base
    img_name = f"{timestamp}_{estado}_{safe_patente}.jpg"
    final_img_path = os.path.join(PENDING_DIR, img_name)
    
    try:
        os.replace(img_path, final_img_path) # Movimiento atómico
        
        metadata = {
            "timestamp": datetime.now().isoformat(),
            "patente": patente,
            "estado": estado, # "EXITO" o "FALLO"
            "imagen": img_name
        }
        with open(json_path, 'w') as f:
            json.dump(metadata, f)
        print(f"💾 Reporte guardado en cola: {estado} - {patente}")
    except Exception as e:
        print(f"❌ Error al guardar en cola: {e}")

def hilo_actualizacion_patentes():
    """Mantiene la base de datos local actualizada."""
    while True:
        time.sleep(INTERVALO_ACTUALIZACION_PATENTES)
        try:
            headers = {"Authorization": f"Bearer {API_TOKEN}"}
            response = requests.get(URL_ENDPOINT_PATENTES, headers=headers, timeout=5)
            if response.status_code == 200:
                data = response.json()
                temp_file = DB_LOCAL + ".tmp"
                with open(temp_file, 'w') as f:
                    json.dump({"patentes": list(set(data.get("patentes", [])))}, f)
                os.replace(temp_file, DB_LOCAL)
        except requests.exceptions.RequestException:
            pass # Silencioso, ya tenemos la caché local

def hilo_subida_reportes():
    """Procesa la carpeta 'pendientes_uploads' y envía al servidor."""
    print("📤 Hilo de subida de reportes iniciado.")
    while True:
        time.sleep(INTERVALO_SUBIDA_REPORTES)
        
        # Buscar todos los archivos .json en la carpeta de pendientes
        json_files = glob.glob(os.path.join(PENDING_DIR, "*.json"))
        
        for json_path in json_files:
            try:
                with open(json_path, 'r') as f:
                    metadata = json.load(f)
                
                img_path = os.path.join(PENDING_DIR, metadata["imagen"])
                
                if not os.path.exists(img_path):
                    print(f"⚠️ Imagen faltante para {json_path}. Eliminando JSON huérfano.")
                    os.remove(json_path)
                    continue

                # Preparar la petición multipart/form-data
                files = {
                    'imagen': (metadata["imagen"], open(img_path, 'rb'), 'image/jpeg')
                }
                data_payload = {
                    'timestamp': metadata["timestamp"],
                    'patente': metadata["patente"] or "",
                    'estado': metadata["estado"]
                }
                headers = {"Authorization": f"Bearer {API_TOKEN}"}

                print(f"⬆️ Enviando reporte: {metadata['estado']} - {metadata['patente']}")
                
                # Timeout más largo para la subida de imágenes (ej. 15 seg)
                response = requests.post(URL_ENDPOINT_REPORTES, files=files, data=data_payload, headers=headers, timeout=15)
                
                if response.status_code == 200:
                    print("✅ Reporte enviado con éxito. Limpiando archivos locales.")
                    os.remove(img_path)
                    os.remove(json_path)
                else:
                    print(f"⚠️ El servidor rechazó el reporte (HTTP {response.status_code}). Se reintentará luego.")
                    
            except requests.exceptions.RequestException as e:
                print(f"⚠️ Sin conexión o error de red. Los reportes se acumularán hasta que vuelva internet. ({e})")
                break # Salir del bucle for para reintentar en el próximo ciclo
            except Exception as e:
                print(f"❌ Error inesperado procesando {json_path}: {e}")
                # No borramos los archivos para no perder evidencia, se reintentará

def abrir_porton():
    print("✅ Abriendo portón...")
    rele_porton.on()
    time.sleep(TIEMPO_ACTIVACION_RELE)
    rele_porton.off()
    publicar_estado("ABIERTO")

def manejar_deteccion(patentes_autorizadas):
    print("🚨 Movimiento detectado!")
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    img_temp_path = f"temp_{timestamp}.jpg"
    
    cap = cv2.VideoCapture(CAMARA_INDEX)
    if not cap.isOpened():
        return
        
    time.sleep(0.5)
    ret, frame = cap.read()
    cap.release()
    
    if ret:
        cv2.imwrite(img_temp_path, frame)
        patente_detectada = detectar_patente(img_temp_path)
        
        if patente_detectada:
            if patente_detectada in patentes_autorizadas:
                guardar_en_cola_reportes(img_temp_path, patente_detectada, "EXITO")
                abrir_porton()
            else:
                print(f"⛔ Patente NO autorizada: {patente_detectada}")
                guardar_en_cola_reportes(img_temp_path, patente_detectada, "FALLO")
        else:
            print("⚠️ No se pudo leer ninguna patente.")
            guardar_en_cola_reportes(img_temp_path, None, "FALLO_LECTURA")
            
        # Limpieza de seguridad: si algo falló y la imagen no se movió a 'pendientes', borrarla
        if os.path.exists(img_temp_path):
            os.remove(img_temp_path)

# --- BUCLE PRINCIPAL ---
if __name__ == "__main__":
    print("🚀 Iniciando Sistema de Control de Acceso Avanzado...")
    
    patentes_actuales = cargar_patentes_locales()
    
    # Iniciar hilos en segundo plano (daemons)
    threading.Thread(target=hilo_actualizacion_patentes, daemon=True).start()
    threading.Thread(target=hilo_subida_reportes, daemon=True).start()
    
    print("👂 Escuchando sensor PIR...")
    try:
        while True:
            pir.wait_for_motion()
            patentes_actuales = cargar_patentes_locales() # Refresco rápido
            manejar_deteccion(patentes_actuales)
            time.sleep(3) # Anti-rebote
            pir.wait_for_no_motion()
    except KeyboardInterrupt:
        print("\n🛑 Sistema detenido.")